---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCurrentPosts, getProjects } from "../lib/content";
import { getPodcast } from "../lib/tokenizados";
import { ROLES } from "../data/roles";
import { EMAIL, SITE_DESCRIPTION, SITE_TITLE, TOKENIZADOS } from "../lib/consts";
import { formatDate, getBlogUrl, getProjectUrl } from "../lib/utils";

const building = await Promise.all(
  (await getProjects())
    .filter((p) => p.data.status === "building")
    .reverse() // Oldest first: the longest-running product leads.
    .map(async (project) => ({ project, Content: (await render(project)).Content }))
);

const podcast = await getPodcast({ limit: 3 });
// The latest episode number is the episode count; the fallback is the count on 2026-09-26.
const episodeCount = podcast.episodes[0]?.number ?? 25;

// Rendered only when there is recent writing, so the site never looks abandoned.
const notes = (await getCurrentPosts()).slice(0, 5);
---

<BaseLayout title={`${SITE_TITLE} · Product engineer`} description={SITE_DESCRIPTION}>
  <section>
    <h1>I build thoughtful digital products.</h1>
    <p>Product engineer working at the intersection of frontend, product, and AI.</p>
    <a href="#building">See what I'm building →</a>
    {
      notes.length > 0 ? (
        <a href="/blog/">Read my writing →</a>
      ) : (
        <a href={TOKENIZADOS.site}>Listen to Tokenizados →</a>
      )
    }
  </section>

  <section id="building">
    <h2>What I'm building</h2>
    {
      building.map(({ project, Content }) => (
        <article>
          {project.data.mainImage && (
            <img src={project.data.mainImage.src} alt={project.data.mainImage.alt} />
          )}
          <h3>{project.data.title}</h3>
          <p>{project.data.excerpt}</p>
          <Content />
          <dl>
            {project.data.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
          <a href={project.data.url}>Visit {project.data.title} →</a>
          {project.data.links.map((link) => (
            <a href={link.url}>{link.label}</a>
          ))}
        </article>
      ))
    }
  </section>

  <section id="tokenizados">
    <h2>Tokenizados</h2>
    <img src="/images/tokenizados/cover.webp" alt="Tokenizados podcast cover art" />
    <p>
      A weekly podcast in Spanish about AI, recorded in the Canary Islands. I host it with Antonio
      Sejas.
    </p>
    <p>{episodeCount} episodes since March 2026, each 45 to 75 minutes long.</p>
    {
      podcast.episodes.length > 0 && (
        <>
          <h3>Latest episodes</h3>
          <ol>
            {podcast.episodes.map((episode) => (
              <li>
                <a href={episode.link}>
                  #{episode.number} {episode.title}
                </a>
                <time datetime={episode.date.toISOString()}>{formatDate(episode.date)}</time>
              </li>
            ))}
          </ol>
        </>
      )
    }
    <ul>
      {
        TOKENIZADOS.platforms.map((platform) => (
          <li>
            <a href={platform.url}>{platform.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    notes.length > 0 && (
      <section>
        <h2>Notes from building</h2>
        <ul>
          {notes.map((note) => (
            <li>
              <a href={getBlogUrl(note.id, note.data.publishedAt)}>{note.data.title}</a>
              <p>{note.data.excerpt}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2>Experience</h2>
    <ol>
      {
        ROLES.map((role) => (
          <li>
            <h3>
              {role.title}, {role.url ? <a href={role.url}>{role.company}</a> : role.company}
            </h3>
            <p>
              {role.start} – {role.end ?? "now"}
            </p>
            <p>{role.impact}</p>
          </li>
        ))
      }
    </ol>
    <p>
      Before that, I co-founded <a href={getProjectUrl("kontroloo")}>Kontroloo</a>, NFC access control
      and cashless payments for events (2017), and <a href={getProjectUrl("food-to-bento")}
        >Food to Bento</a
      >, an app against food waste (2018–2019), both in Las Palmas.
    </p>
  </section>

  <section>
    <h2>About</h2>
    <p>
      I'm Jorge, a product-minded engineer based in the Canary Islands. I've spent the last nine
      years building web and mobile products, mostly on the frontend and product side.
    </p>
    <p>
      Lately I've been exploring what changes when AI is part of the product itself instead of a
      feature added on top. I like simple interfaces and opinionated products, and I like turning
      messy ideas into things people can actually use.
    </p>
    <p>The best way to reach me is email: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  </section>
</BaseLayout>
