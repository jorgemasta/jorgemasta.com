---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getAbout,
  getCurrentPosts,
  getEpisodeCount,
  getHomepageProjects,
  getLabs,
  getProjectHref,
  getRoles,
  getShownPodcast,
} from "../lib/content";
import { EMAIL, SITE_DESCRIPTION, SITE_TITLE, TOKENIZADOS } from "../lib/consts";
import { formatDate, getBlogUrl, getLabUrl } from "../lib/utils";
import { hostname, withTail } from "../lib/hostname";

const { building: buildingProjects, earlier } = await getHomepageProjects();
const building = await Promise.all(
  buildingProjects.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
    site: withTail(hostname(project.data.url!)),
  }))
);

const labs = await getLabs();
const roles = await getRoles();
const notes = (await getCurrentPosts()).slice(0, 3);
const episodeCount = getEpisodeCount(await getShownPodcast());
const about = await getAbout();

const year = (date: Date) => date.getUTCFullYear();
---

<BaseLayout title={`${SITE_TITLE} · Product engineer`} description={SITE_DESCRIPTION}>
  <!-- Hero: one claim, then professional proof first and side projects last. -->
  <section class="mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28 sm:pb-24">
    <p class="hero-enter font-mono text-xs tracking-[0.08em] text-terracotta uppercase" style="--i:0">Product engineer · Canary Islands</p>
    <h1 class="hero-enter mt-5 max-w-4xl text-5xl leading-[1.05] tracking-tight sm:text-7xl" style="--i:1">
      Hi, I'm Jorge. I build and improve <em class="text-terracotta">digital products</em>.
    </h1>
    <p class="hero-enter mt-7 max-w-2xl text-lg leading-relaxed text-charcoal sm:text-xl wrap-anywhere" style="--i:2">
      I'm a product engineer. For nine years I've shipped web and mobile products for teams like Harvard, Vimeo and
      BigCommerce, and now I work at Nexcess.
      {
        building.length > 0 && (
          <>
            {" "}
            On my own, I run{" "}
            {building.map(({ project }, i) => (
              <>
                {i > 0 && (i === building.length - 1 ? " and " : ", ")}
                <a href={`#project-${project.id}`}>{project.data.title}</a>
              </>
            ))}
            .
          </>
        )
      }
    </p>
  </section>

  {
    roles.length > 0 && (
      <section id="work" class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="section-heading">Work</h2>
        <ol class="mt-6">
          {roles.map((role) => (
            <li class="grid grid-cols-1 gap-x-10 gap-y-1 border-t border-rule py-6 sm:grid-cols-[9rem_minmax(0,1fr)]">
              <p class="pt-1 font-mono text-xs text-muted">
                {role.start}
                {role.end !== role.start && <> – {role.end ?? "now"}</>}
              </p>
              <div class="min-w-0 wrap-anywhere">
                <h3 class="text-2xl leading-snug">
                  {role.url ? (
                    <a href={role.url} class="link-quiet" target="_blank" rel="noopener noreferrer">
                      {role.company}
                    </a>
                  ) : (
                    role.company
                  )}
                </h3>
                <p class="mt-0.5 text-sm text-muted">{role.title}</p>
                {role.impact.trim() && <p class="mt-3 max-w-2xl leading-relaxed text-charcoal">{role.impact}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    (building.length > 0 || labs.length > 0 || earlier.length > 0) && (
      <section id="building" class="mx-auto mt-24 max-w-5xl px-4 sm:px-6">
        <h2 class="section-heading">Building on my own</h2>
        {building.length > 0 && (
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
            Products I run end to end, where I own the whole thing: data, SEO, monetisation and reliability.
          </p>
        )}

        {building.map(({ project, Content, site }) => (
          <article id={`project-${project.id}`} class="mt-8 border-t border-rule pt-8 wrap-anywhere">
            <h3 class="text-3xl sm:text-4xl">{project.data.title}</h3>
            <p class="mt-2 max-w-2xl text-lg leading-relaxed text-charcoal">{project.data.excerpt}</p>
            <div class="prose mt-4 max-w-2xl leading-relaxed">
              <Content />
            </div>
            {project.data.stats.length > 0 && (
              <dl class="mt-6 flex flex-wrap items-start gap-x-10 gap-y-4">
                {project.data.stats.map((stat) => (
                  <div class="flex min-w-0 flex-col-reverse">
                    <dt class="text-xs text-muted">{stat.label}</dt>
                    <dd class="font-serif text-3xl text-green lining-nums">{stat.value}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
              <a href={project.data.url} class="action min-w-0" target="_blank" rel="noopener noreferrer">
                Visit {site.head}
                <span class="whitespace-nowrap">
                  {site.tail}<span class="arrow" aria-hidden="true">&nbsp;→</span>
                </span>
              </a>
              {project.data.links.map((link) => (
                <a href={link.url} class="link-quiet text-muted hover:text-green" target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}

        {labs.length > 0 && (
          <div class="mt-16">
            <h3 class="eyebrow font-sans">Labs</h3>
            <ul class="mt-4">
              {labs.map((lab) => (
                <li class="grid grid-cols-1 gap-x-10 gap-y-1 border-t border-rule py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
                  <p class="pt-0.5 font-mono text-xs text-muted">
                    <time datetime={lab.data.publishedAt.toISOString()}>{year(lab.data.publishedAt)}</time>
                  </p>
                  <p class="min-w-0 leading-relaxed text-muted wrap-anywhere">
                    <span class="font-medium text-charcoal">
                      <a href={getLabUrl(lab.id)}>{lab.data.title}</a>
                    </span>
                    . <span dir="auto">{lab.data.question}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {earlier.length > 0 && (
          <div class="mt-16">
            <h3 class="eyebrow font-sans">Earlier work</h3>
            <ul class="mt-4">
              {earlier.map((project) => (
                <li class="grid grid-cols-1 gap-x-10 gap-y-1 border-t border-rule py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
                  <p class="pt-0.5 font-mono text-xs text-muted">
                    <time datetime={project.data.publishedAt.toISOString()}>{year(project.data.publishedAt)}</time>
                  </p>
                  <p class="min-w-0 leading-relaxed text-muted wrap-anywhere">
                    <span class="font-medium text-charcoal">
                      <a href={getProjectHref(project)}>{project.data.title}</a>
                    </span>
                    . <span dir="auto">{project.data.excerpt}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <section id="writing" class="mx-auto mt-24 max-w-5xl px-4 sm:px-6">
    <h2 class="section-heading">Writing &amp; podcast</h2>
    <div class="mt-6 grid grid-cols-1 gap-12 border-t border-rule pt-8 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      {
        notes.length > 0 && (
          <div class="min-w-0">
            <ul class="space-y-8">
              {notes.map((note) => (
                <li class="wrap-anywhere">
                  <time class="font-mono text-xs text-muted" datetime={note.data.publishedAt.toISOString()}>
                    {formatDate(note.data.publishedAt)}
                  </time>
                  <a
                    href={getBlogUrl(note.id, note.data.publishedAt)}
                    class="link-quiet mt-1 block font-serif text-2xl leading-snug text-green"
                  >
                    {note.data.title}
                  </a>
                  <p class="mt-1 line-clamp-3 text-muted" dir="auto">{note.data.excerpt}</p>
                </li>
              ))}
            </ul>
            <a href="/blog/" class="action mt-8 inline-block text-sm">Read the <span class="whitespace-nowrap">latest<span class="arrow" aria-hidden="true">&nbsp;→</span></span></a>
          </div>
        )
      }

      <div id="tokenizados" class="min-w-0 wrap-anywhere">
        <h3 class="text-3xl">
          <a href={TOKENIZADOS.site} class="link-quiet" target="_blank" rel="noopener noreferrer">
            Tokenizados
          </a>
        </h3>
        <p class="mt-3 leading-relaxed text-charcoal">{TOKENIZADOS.about}</p>
        <p class="mt-2 leading-relaxed text-muted">{TOKENIZADOS.episodesSince(episodeCount)}</p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Listen on">
          {
            TOKENIZADOS.platforms.map((platform) => (
              <li>
                <a href={platform.url} target="_blank" rel="noopener noreferrer">
                  {platform.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="@container mx-auto mt-32 max-w-5xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 @3xl:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] @3xl:gap-12">
      <div>
        <!-- Placeholder until the real portrait lands. -->
        <div
          class="flex aspect-[4/5] w-40 max-w-full items-end rounded-md bg-olive p-4 font-serif text-4xl text-paper sm:w-56"
          role="img"
          aria-label="Jorge Masta"
        >
          JM
        </div>
      </div>
      <div class="min-w-0 wrap-break-word">
        <h2 class="text-4xl sm:text-5xl">About</h2>
        <div class="mt-6 max-w-xl space-y-4 text-lg leading-relaxed">
          {about.map((paragraph) => <p>{paragraph}</p>)}
          <p>
            The best way to reach me is email: <a href={`mailto:${EMAIL}`} class="font-serif text-xl wrap-anywhere"
              >{EMAIL}</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-heading {
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  @media (width >= 40rem) {
    .section-heading {
      font-size: 3rem;
    }
  }
</style>
