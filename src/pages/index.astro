---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getCurrentPosts,
  getEpisodeCount,
  getProjects,
  getShownPodcast,
  isBuilding,
} from "../lib/content";
import { anchors } from "../lib/registry";
import { ROLES } from "../data/roles";
import { EMAIL, SITE_DESCRIPTION, SITE_TITLE, TOKENIZADOS } from "../lib/consts";
import { formatDate, getBlogUrl, getProjectUrl } from "../lib/utils";

const building = await Promise.all(
  (await getProjects())
    .filter(isBuilding)
    .reverse() // Oldest first: the longest-running product leads.
    .map(async (project) => ({ project, Content: (await render(project)).Content }))
);

const podcast = await getShownPodcast();
const episodeCount = getEpisodeCount(podcast);

// Rendered only when there is recent writing, so the site never looks abandoned.
const notes = (await getCurrentPosts()).slice(0, 5);

const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, "");
---

<BaseLayout title={`${SITE_TITLE} · Product engineer`} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 pt-20 pb-24 sm:px-6 sm:pt-28 sm:pb-32">
    <h1 class="max-w-3xl text-5xl leading-[1.05] tracking-tight sm:text-7xl">
      I build thoughtful digital products.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
      Product engineer working at the intersection of frontend, product, and AI.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a href="#building" class="button">See what I'm building <span aria-hidden="true">→</span></a>
      {
        notes.length > 0 ? (
          <a href="/blog/" class="action">
            Read my writing <span aria-hidden="true">→</span>
          </a>
        ) : (
          <a href={TOKENIZADOS.site} class="action" target="_blank" rel="noopener noreferrer">
            Listen to Tokenizados <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </section>

  <!-- What I'm building -->
  <section id="building" class="mx-auto max-w-5xl scroll-mt-8 px-4 sm:px-6">
    <p class="eyebrow">Now</p>
    <h2 class="mt-2 text-4xl sm:text-5xl">What I'm building</h2>

    <div class="mt-14 flex flex-col gap-24">
      {
        building.map(({ project, Content }, i) => (
          <article
            id={anchors.project(project.id)}
            class="grid items-start gap-8 md:grid-cols-12 md:gap-12"
          >
            {project.data.mainImage && (
              <a
                href={project.data.url}
                target="_blank"
                rel="noopener noreferrer"
                tabindex="-1"
                aria-hidden="true"
                class:list={["block md:col-span-7", i % 2 === 1 && "md:order-2"]}
              >
                <img
                  src={project.data.mainImage.src}
                  alt={project.data.mainImage.alt}
                  width="1200"
                  height="750"
                  loading={i === 0 ? "eager" : "lazy"}
                  class="w-full rounded-md border border-rule shadow-[0_24px_48px_-24px_rgb(23_63_53/0.35)]"
                />
              </a>
            )}
            <div class="md:col-span-5">
              <h3 class="text-3xl sm:text-4xl">{project.data.title}</h3>
              <p class="mt-3 text-lg leading-relaxed text-charcoal">{project.data.excerpt}</p>
              <div class="prose mt-4 max-w-none leading-relaxed">
                <Content />
              </div>
              {project.data.stats.length > 0 && (
                <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4 border-t border-rule pt-5">
                  {project.data.stats.map((stat) => (
                    <div class="flex flex-col-reverse">
                      <dt class="text-xs text-muted">{stat.label}</dt>
                      <dd class="font-serif text-3xl text-green">{stat.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a
                  href={project.data.url}
                  class="action"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visit {hostname(project.data.url!)} <span aria-hidden="true">→</span>
                </a>
                {project.data.links.map((link) => (
                  <a
                    href={link.url}
                    class="text-sm text-muted hover:text-green"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Tokenizados -->
  <section id={anchors.tokenizados} class="mt-32 bg-green text-paper">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-4 py-20 sm:px-6 md:grid-cols-12 md:gap-12 md:py-24"
    >
      <div class="md:col-span-4">
        <img
          src="/images/tokenizados/cover.webp"
          alt="Tokenizados podcast cover art"
          width="480"
          height="480"
          loading="lazy"
          class="w-40 rounded-md sm:w-56"
        />
      </div>
      <div class="md:col-span-8">
        <p class="eyebrow text-[#e2a283]">Podcast</p>
        <h2 class="mt-2 text-4xl text-paper sm:text-5xl">Tokenizados</h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper/90">{TOKENIZADOS.about}</p>
        <p class="mt-2 text-paper/70">{TOKENIZADOS.length(episodeCount)}</p>

        {
          podcast.episodes.length > 0 && (
            <>
              <h3 class="mt-10 font-sans text-xs font-semibold tracking-[0.12em] text-paper/60 uppercase">
                Latest episodes
              </h3>
              <ol class="mt-3 border-t border-paper/20">
                {podcast.episodes.map((episode) => (
                  <li id={anchors.episode(episode.number)} class="border-b border-paper/20">
                    <a
                      href={episode.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex flex-col gap-1 py-4 text-paper no-underline sm:flex-row sm:items-baseline sm:gap-6"
                    >
                      <span class="shrink-0 text-sm whitespace-nowrap text-paper/60 tabular-nums sm:w-40">
                        <time datetime={episode.date.toISOString()}>
                          {formatDate(episode.date)}
                        </time>
                      </span>
                      <span class="font-serif text-lg leading-snug group-hover:underline">
                        <span class="text-paper/60">#{episode.number}</span> {episode.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </>
          )
        }

        <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Listen on">
          {
            TOKENIZADOS.platforms.map((platform) => (
              <li>
                <a
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block rounded-full border border-paper/30 px-4 py-1.5 text-sm text-paper no-underline transition-colors hover:border-paper hover:bg-paper hover:text-green"
                >
                  {platform.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Notes from building -->
  {
    notes.length > 0 && (
      <section class="mx-auto mt-32 max-w-5xl px-4 sm:px-6">
        <p class="eyebrow">Writing</p>
        <h2 class="mt-2 text-4xl sm:text-5xl">Notes from building</h2>
        <ul class="mt-10 border-t border-rule">
          {notes.map((note) => (
            <li class="border-b border-rule">
              <a
                href={getBlogUrl(note.id, note.data.publishedAt)}
                class="group grid gap-1 py-6 no-underline sm:grid-cols-12 sm:gap-6"
              >
                <time
                  datetime={note.data.publishedAt.toISOString()}
                  class="text-sm text-muted tabular-nums sm:col-span-3"
                >
                  {formatDate(note.data.publishedAt)}
                </time>
                <span class="sm:col-span-9">
                  <span class="font-serif text-2xl text-green group-hover:underline">
                    {note.data.title}
                  </span>
                  <span class="mt-1 block text-charcoal">{note.data.excerpt}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Experience -->
  <section class="mx-auto mt-32 max-w-5xl px-4 sm:px-6">
    <p class="eyebrow">Career</p>
    <h2 class="mt-2 text-4xl sm:text-5xl">Experience</h2>
    <ol class="mt-10 border-t border-rule">
      {
        ROLES.map((role) => (
          <li
            id={anchors.role(role.id)}
            class="grid gap-1 border-b border-rule py-6 sm:grid-cols-12 sm:gap-6"
          >
            <p class="text-sm text-muted tabular-nums sm:col-span-3 sm:pt-1">
              {role.start} – {role.end ?? "now"}
            </p>
            <div class="sm:col-span-9">
              <h3 class="text-2xl">
                {role.title},{" "}
                {role.url ? (
                  <a href={role.url} target="_blank" rel="noopener noreferrer">
                    {role.company}
                  </a>
                ) : (
                  role.company
                )}
              </h3>
              <p class="mt-1 max-w-2xl leading-relaxed">{role.impact}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 max-w-2xl leading-relaxed text-muted sm:ml-[25%] sm:pl-4">
      Before that, I co-founded <a href={getProjectUrl("kontroloo")}>Kontroloo</a>, NFC access
      control and cashless payments for events (2017), and <a href={getProjectUrl("food-to-bento")}
        >Food to Bento</a
      >, an app against food waste (2018–2019), both in Las Palmas.
    </p>
  </section>

  <!-- About -->
  <section class="mx-auto mt-32 max-w-5xl px-4 sm:px-6">
    <div class="grid gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-4">
        <!-- Placeholder until the real portrait lands. -->
        <div
          class="flex aspect-[4/5] w-40 items-end rounded-md bg-olive p-4 font-serif text-4xl text-paper sm:w-56"
          role="img"
          aria-label="Jorge Masta"
        >
          JM
        </div>
      </div>
      <div class="md:col-span-8">
        <h2 class="text-4xl sm:text-5xl">About</h2>
        <div class="mt-6 max-w-xl space-y-4 text-lg leading-relaxed">
          <p>
            I'm Jorge, a product-minded engineer based in the Canary Islands. I've spent the last
            nine years building web and mobile products, mostly on the frontend and product side.
          </p>
          <p>
            Lately I've been exploring what changes when AI is part of the product itself instead
            of a feature added on top. I like simple interfaces and opinionated products, and I
            like turning messy ideas into things people can actually use.
          </p>
          <p>
            The best way to reach me is email: <a href={`mailto:${EMAIL}`}
              class="font-serif text-xl">{EMAIL}</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
