---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getPosts } from "../../lib/content";
import { getDateSegments, formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const dateStr =
      typeof post.data.publishedAt === "string"
        ? post.data.publishedAt
        : post.data.publishedAt.toISOString().slice(0, 10);
    const { year, month } = getDateSegments(dateStr);
    return {
      params: { slug: `${year}/${month}/${post.id}` },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | @jorgemasta`} description={post.data.excerpt}>
  <article class="mx-auto max-w-3xl px-6 py-12">
    {
      post.data.mainImage && (
        <img
          src={post.data.mainImage.src}
          alt={post.data.mainImage.alt}
          class="mb-8 w-full rounded-xl object-cover"
          style="max-height: 400px"
        />
      )
    }
    <h1
      class="mb-2 text-3xl font-bold sm:text-4xl"
      style="color: var(--color-text-primary)"
    >
      {post.data.title}
    </h1>
    <time
      class="mb-8 block text-sm"
      style="color: var(--color-text-muted)"
      datetime={post.data.publishedAt.toISOString()}
    >
      {formatDate(new Date(post.data.publishedAt))}
    </time>
    <div class="prose prose-lg max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
