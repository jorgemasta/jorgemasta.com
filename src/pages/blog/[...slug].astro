---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getPosts } from "../../lib/content";
import { getDateSegments, formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const dateStr =
      typeof post.data.publishedAt === "string"
        ? post.data.publishedAt
        : post.data.publishedAt.toISOString().slice(0, 10);
    const { year, month } = getDateSegments(dateStr);
    return {
      params: { slug: `${year}/${month}/${post.id}` },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Jorge Masta`} description={post.data.excerpt}>
  <article class="mx-auto max-w-2xl px-4 pt-16 sm:px-6 sm:pt-24">
    <time
      class="text-sm text-muted"
      datetime={post.data.publishedAt.toISOString()}
    >
      {formatDate(post.data.publishedAt)}
    </time>
    <h1 class="mt-3 text-4xl leading-tight tracking-tight sm:text-5xl">
      {post.data.title}
    </h1>
    {
      post.data.mainImage && (
        <img
          src={post.data.mainImage.src}
          alt={post.data.mainImage.alt}
          class="mt-10 max-h-[400px] w-full rounded-md object-cover"
        />
      )
    }
    <div class="prose prose-lg mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
