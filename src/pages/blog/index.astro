---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/content";
import { getBlogUrl, formatDate, isOlderThanOneYear } from "../../lib/utils";

const posts = await getPosts();
---

<BaseLayout title="Writing | Jorge Masta" description="Notes and articles by Jorge Masta">
  <div class="mx-auto max-w-5xl px-4 pt-16 sm:px-6 sm:pt-24">
    <h1 class="text-5xl tracking-tight sm:text-6xl">Writing</h1>
    <ul class="mt-12 border-t border-rule">
      {
        posts.map((post) => (
          <li class="border-b border-rule">
            <a
              href={getBlogUrl(post.id, post.data.publishedAt)}
              class="group grid gap-1 py-6 no-underline sm:grid-cols-12 sm:gap-6"
            >
              <span class="flex items-center gap-2 text-sm text-muted tabular-nums sm:col-span-3 sm:flex-col sm:items-start sm:pt-1.5">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt)}
                </time>
                {isOlderThanOneYear(post.data.publishedAt) && (
                  <span class="badge-archive">Archive</span>
                )}
              </span>
              <span class="sm:col-span-9">
                <span class="font-serif text-2xl text-green group-hover:underline">
                  {post.data.title}
                </span>
                <span class="mt-1 block leading-relaxed text-charcoal">{post.data.excerpt}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
