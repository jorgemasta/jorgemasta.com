---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getLabs } from "../../lib/content";
import { formatDate } from "../../lib/utils";
import VideoPresetsLab from "../../labs/video-presets/VideoPresetsLab";

export async function getStaticPaths() {
  return (await getLabs()).map((lab) => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
---

<BaseLayout title={`${lab.data.title} | Jorge Masta`} description={lab.data.excerpt}>
  <article class="mx-auto max-w-2xl px-4 pt-16 sm:px-6 sm:pt-24">
    <p class="eyebrow font-sans">
      <a href="/lab/" class="link-quiet">Lab</a> ·
      <time datetime={lab.data.publishedAt.toISOString()}>{formatDate(lab.data.publishedAt)}</time>
    </p>
    <h1 class="mt-3 text-4xl leading-tight tracking-tight sm:text-5xl">{lab.data.title}</h1>
    <!-- The question comes first: it is what the experiment tries to find out. -->
    <p dir="auto" class="mt-4 font-serif text-2xl leading-snug text-green wrap-anywhere">{lab.data.question}</p>

    <!--
      Interactive island. The slug picks the Lab's component; it hydrates with
      client:visible so the write-up reads without waiting for script, and its
      server-rendered HTML is the poster.
    -->
    {
      lab.id === "video-presets" ? (
        <div class="mt-10">
          <VideoPresetsLab client:visible={{ rootMargin: "200px" }} poster={lab.data.mainImage} />
        </div>
      ) : (
        lab.data.mainImage && (
          <img
            src={lab.data.mainImage.src}
            alt={lab.data.mainImage.alt}
            class="card-img mt-10 aspect-video w-full rounded-md object-cover"
          />
        )
      )
    }

    <div class="prose prose-lg mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
