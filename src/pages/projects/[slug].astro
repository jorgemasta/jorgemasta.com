---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getProjects, isBuilding } from "../../lib/content";
import { anchors } from "../../lib/registry";
import { formatDate } from "../../lib/utils";

export async function getStaticPaths() {
  const projects = (await getProjects()).filter((p) => !isBuilding(p));
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} | Jorge Masta`} description={project.data.excerpt}>
  <article id={anchors.project(project.id)} class="mx-auto max-w-2xl px-4 pt-16 sm:px-6 sm:pt-24">
    <time
      class="text-sm text-muted"
      datetime={project.data.publishedAt.toISOString()}
    >
      {formatDate(project.data.publishedAt)}
    </time>
    <h1 class="mt-3 text-4xl leading-tight tracking-tight sm:text-5xl">
      {project.data.title}
    </h1>
    {
      project.data.mainImage && (
        <img
          src={project.data.mainImage.src}
          alt={project.data.mainImage.alt}
          class="mt-10 max-h-[400px] w-full rounded-md object-cover"
        />
      )
    }
    <div class="prose prose-lg mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
