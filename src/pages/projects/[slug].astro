---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getProjects, hasDetailPage } from "../../lib/content";
import { formatDate } from "../../lib/utils";
import { hostname, withTail } from "../../lib/hostname";

export async function getStaticPaths() {
  const projects = (await getProjects()).filter(hasDetailPage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { url, stats, links } = project.data;
---

<BaseLayout title={`${project.data.title} | Jorge Masta`} description={project.data.excerpt}>
  <article class="mx-auto max-w-2xl px-4 pt-16 sm:px-6 sm:pt-24">
    <time
      class="text-sm text-muted"
      datetime={project.data.publishedAt.toISOString()}
    >
      {formatDate(project.data.publishedAt)}
    </time>
    <h1 class="mt-3 text-4xl leading-tight tracking-tight sm:text-5xl">
      {project.data.title}
    </h1>
    {project.data.excerpt && (
      <p dir="auto" class="mt-4 text-xl leading-relaxed text-charcoal wrap-anywhere">{project.data.excerpt}</p>
    )}
    {stats.length > 0 && (
      <dl class="mt-8 flex flex-wrap items-start gap-x-8 gap-y-4 border-t border-rule pt-5 wrap-anywhere">
        {stats.map((stat) => (
          <div class="flex min-w-0 flex-col-reverse">
            <dt class="text-xs text-muted">{stat.label}</dt>
            <dd class="font-serif text-3xl text-green">{stat.value}</dd>
          </div>
        ))}
      </dl>
    )}
    {(url || links.length > 0) && (
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 wrap-anywhere">
        {url && (
          <a href={url} class="action min-w-0" target="_blank" rel="noopener noreferrer">
            Visit {withTail(hostname(url)).head}<span class="whitespace-nowrap"
              >{withTail(hostname(url)).tail}&nbsp;<span aria-hidden="true">→</span></span
            >
          </a>
        )}
        {links.map((link) => (
          <a
            href={link.url}
            class="min-w-0 text-sm text-muted hover:text-green"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
    {
      project.data.mainImage && (
        <img
          src={project.data.mainImage.src}
          alt={project.data.mainImage.alt}
          class="mt-10 aspect-[16/10] max-h-[400px] w-full rounded-md object-cover object-top"
        />
      )
    }
    <div class="prose prose-lg mt-10 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
