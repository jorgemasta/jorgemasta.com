---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Jorge Masta" description="Page not found">
  <div class="mx-auto max-w-5xl px-4 pt-24 pb-12 sm:px-6 sm:pt-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 max-w-2xl text-5xl leading-tight tracking-tight sm:text-6xl">
      This page doesn't exist.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed">
      It may have moved when the site was rebuilt. Everything current is linked from the homepage.
    </p>
    <a href="/" class="button mt-10">Back to the homepage <span aria-hidden="true">→</span></a>
  </div>
</BaseLayout>
