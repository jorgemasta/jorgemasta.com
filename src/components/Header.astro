---
import { SITE_AUTHOR, SOCIAL_LINKS } from "../lib/consts";

const path = Astro.url.pathname;
const sections = [
  { label: "Writing", href: "/blog/" },
  { label: "Projects", href: "/projects/" },
];
const socials = [
  { label: "GitHub", href: SOCIAL_LINKS.github },
  { label: "X", href: SOCIAL_LINKS.x },
  { label: "LinkedIn", href: SOCIAL_LINKS.linkedin },
];
---

<header class="mx-auto max-w-5xl px-4 sm:px-6">
  <nav
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule py-5"
    aria-label="Main"
  >
    <a href="/" class="font-serif text-xl text-green no-underline">{SITE_AUTHOR}</a>
    <ul class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm sm:gap-x-5">
      {
        sections.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                "no-underline hover:underline",
                path.startsWith(href) ? "text-green" : "text-charcoal",
              ]}
              aria-current={path.startsWith(href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li aria-hidden="true" class="text-rule">|</li>
      {
        socials.map(({ label, href }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted no-underline hover:text-green hover:underline"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
