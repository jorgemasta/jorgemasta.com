---
import { SITE_AUTHOR, SOCIAL_LINKS } from "../lib/consts";

const path = Astro.url.pathname;
const sections = [
  { label: "Writing", href: "/blog/" },
  { label: "Projects", href: "/projects/" },
];
const socials = [
  { label: "GitHub", href: SOCIAL_LINKS.github },
  { label: "X", href: SOCIAL_LINKS.x },
  { label: "LinkedIn", href: SOCIAL_LINKS.linkedin },
];
---

<header class="mx-auto max-w-5xl px-4 sm:px-6">
  <nav
    class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule py-5"
    aria-label="Main"
  >
    <a href="/" class="font-serif text-xl text-green no-underline">{SITE_AUTHOR}</a>
    {/*
      Two groups that wrap only as whole groups. Each group sits after a
      gap (pl-6) that the -ml-6 cancels at the start of a line, and the
      clip hides the "|" in that gap, so it shows only between groups on
      one line. The clip margin leaves room for the focus ring.
    */}
    <div class="min-w-0 overflow-clip [overflow-clip-margin:6px] text-sm">
      <div class="-ml-6 flex flex-wrap items-baseline gap-y-1 sm:-ml-9">
        <ul class="flex flex-wrap items-baseline gap-x-4 pl-6 sm:gap-x-5 sm:pl-9">
          {
            sections.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    "no-underline hover:underline",
                    path.startsWith(href) ? "text-green" : "text-charcoal",
                  ]}
                  aria-current={path.startsWith(href) ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="relative flex flex-wrap items-baseline gap-x-4 pl-6 sm:gap-x-5 sm:pl-9">
          <li aria-hidden="true" class="absolute top-0 left-0 w-6 text-center text-rule sm:w-9">|</li>
          {
            socials.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted no-underline hover:text-green hover:underline"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>
