{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jorgemasta-com",
  "compatibility_date": "2026-09-25",
  // The site is static. The Worker script only handles the Concierge's
  // endpoint (ADR 0004); every other route is served straight from the assets.
  // `_redirects` lives in public/ and is copied into dist/ by Astro.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Keep in sync with CONCIERGE_ENDPOINT in src/lib/consts.ts.
    "run_worker_first": ["/concierge/chat"]
  },
  // Secrets (CF_ACCOUNT_ID, CF_AI_GATEWAY, CF_AIG_TOKEN) are in .dev.vars
  // locally and `wrangler secret`s when deployed; see .dev.vars.example.
  "vars": {
    "CONCIERGE_MODEL": "openai/gpt-6-luna",
    "CONCIERGE_REASONING_EFFORT": "none"
  }
}
