{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jorgemasta-com",
  "compatibility_date": "2026-09-25",
  // Static site: no Worker script, just the built assets.
  // `_redirects` lives in public/ and is copied into dist/ by Astro.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
